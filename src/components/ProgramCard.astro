---
// `cardImage` is the home-page card photo; `icon` (an emoji) is the fallback for a program
// with no photo yet. Swapping a photo is a frontmatter edit — crop recipes live in
// docs/program-card-images.md.
const { href, title, summary, icon, cardImage } = Astro.props;
---
<a class="pcard" href={href}>
  {cardImage
    ? <img class="top-img" src={cardImage} alt="" width="1200" height="400" loading="lazy" decoding="async" />
    : <div class="top">{icon}</div>}
  <div class="body">
    <h3>{title}</h3>
    <p>{summary}</p>
    <span class="go">View program →</span>
  </div>
</a>
<style>
  .pcard { display: block; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: #fff; transition: .15s; color: inherit; }
  .pcard:hover { transform: translateY(-3px); box-shadow: 0 12px 28px rgba(16,58,107,.13); text-decoration: none; }
  .pcard .top { height: 92px; display: flex; align-items: center; justify-content: center; font-size: 2.1rem; background: linear-gradient(135deg, var(--navy), var(--royal)); }
  /* Fixed height + cover, so a replacement photo of any ratio can't reflow the grid. */
  .pcard .top-img { display: block; width: 100%; height: 92px; object-fit: cover; }
  .pcard .body { padding: var(--space-sm); }
  .pcard h3 { font-size: var(--fs-md); }
  .pcard p { font-size: var(--fs-sm); color: var(--muted); margin: var(--space-3xs) 0 var(--space-2xs); }
  .pcard .go { font-family: "Raleway"; font-weight: var(--fw-bold); font-size: var(--fs-sm); color: var(--royal); }
</style>
