---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container foot">
    <img src="/images/logo-seal.png" alt="LAHS seal" width="74" height="74" />
    <div>
      <strong>LAHS Performing Arts Boosters</strong><br />
      201 Almond Avenue, Los Altos, CA 94022 · EIN 77-0525170
    </div>
    <div class="spacer">A 501(c)(3) nonprofit · &copy; {year}<br />lahsperformingartsboosters.org</div>
  </div>
</footer>
<style>
  .site-footer { background: var(--navy-d); color: #cdd9ea; font-size: var(--fs-sm); margin-top: var(--space-xl); }
  .foot { display: flex; gap: var(--space-md); align-items: center; padding: var(--space-lg) var(--space-md); }
  .foot strong { color: #fff; font-family: "Raleway"; font-weight: var(--fw-bold); }
  .foot .spacer { margin-left: auto; text-align: right; color: #9fb3d1; }
  @media (max-width: 720px) {
    .foot { flex-direction: column; align-items: flex-start; gap: var(--space-sm); }
    .foot .spacer { margin-left: 0; text-align: left; }
  }
</style>
