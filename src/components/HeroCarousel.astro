---
// images: slides from /images/hero/. Empty array → gradient-only hero.
// The hero is a `cover` box that is ~4:1 on desktop but nearly square on mobile, so it
// re-crops per viewport. `position` is the CSS background-position that decides what
// survives that crop — raise it above 50% when the subject sits high in the frame
// (a conductor's head, a show title) or centre-cropping will cut it off on desktop.
export interface HeroImage {
  src: string;
  position?: string;
}
interface Props {
  images?: HeroImage[];
  title: string;
  subtitle?: string;
}
const { images = [], title, subtitle } = Astro.props;
---
<section class="hero">
  <div class="slides">
    {images.length === 0 && <div class="slide on gradient"></div>}
    {images.map((img, i) => (
      <div
        class={`slide ${i === 0 ? 'on' : ''}`}
        style={`background-image:url('${img.src}');background-position:${img.position ?? 'center'}`}
      ></div>
    ))}
  </div>
  <div class="scrim"></div>
  <div class="container hero-content">
    <p class="kick">Parent-led · 501(c)(3) nonprofit</p>
    <h1>{title}</h1>
    {subtitle && <p class="sub">{subtitle}</p>}
    <div class="cta">
      <a class="btn btn-primary" href="/donate/">Donate</a>
    </div>
  </div>
</section>
<style>
  .hero { position: relative; height: 460px; overflow: hidden; background: var(--navy-d); }
  .slides, .slide { position: absolute; inset: 0; }
  .slide { background-size: cover; background-position: center; opacity: 0; transition: opacity 1.1s ease; }
  .slide.on { opacity: 1; }
  .slide.gradient { background: linear-gradient(120deg, #0d2f57, #1c4f8f); opacity: 1; }
  .scrim { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(8,28,55,.86), rgba(8,28,55,.45) 60%, rgba(8,28,55,.2)); }
  .hero-content { position: relative; height: 100%; display: flex; flex-direction: column; justify-content: center; color: #fff; }
  .hero-content h1 { color: #fff; font-size: var(--fs-hero); font-weight: var(--fw-heading); max-width: 18ch; text-shadow: 0 2px 18px rgba(0,0,0,.35); }
  .kick { font-family: "Raleway"; font-weight: var(--fw-bold); letter-spacing: 3px; text-transform: uppercase; font-size: var(--fs-eyebrow); color: #cdb27a; margin-bottom: var(--space-xs); }
  .sub { font-size: var(--fs-md); color: #e3ebf6; max-width: 46ch; margin: var(--space-sm) 0 var(--space-md); }
  .cta { display: flex; gap: var(--space-xs); flex-wrap: wrap; }
  @media (max-width: 720px) {
    .hero { height: 360px; }
    .sub { font-size: var(--fs-base); }
    .cta { flex-direction: column; align-items: stretch; }
    .cta .btn { text-align: center; }
  }
</style>
<script>
  const slides = [...document.querySelectorAll('.hero .slide')];
  // Don't auto-advance for visitors who asked for reduced motion; they get the first slide.
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (slides.length > 1 && !still) {
    let cur = 0;
    setInterval(() => {
      slides[cur].classList.remove('on');
      cur = (cur + 1) % slides.length;
      slides[cur].classList.add('on');
    }, 4500);
  }
</script>
