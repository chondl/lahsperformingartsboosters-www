---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const programs = await getCollection('programs');
  return programs.map((p) => ({ params: { slug: p.id }, props: { program: p } }));
}

const { program } = Astro.props;
const { Content } = await render(program);
const d = program.data;
---
<BaseLayout title={d.title} description={d.summary}>
  <article class={`container section prose prose-${program.id}`}>
    <h1>{d.title}</h1>
    <Content />
    {(d.updatesFormUrl || d.volunteerSheetUrl || d.googleGroupUrl || d.showDonate) && (
      <div class="program-actions">
        {d.updatesFormUrl && <a class="btn" href={d.updatesFormUrl}>{d.updatesFormLabel}</a>}
        {d.volunteerSheetUrl && <a class="btn" href={d.volunteerSheetUrl}>Volunteer sign-up sheet</a>}
        {d.googleGroupUrl && <a class="btn" href={d.googleGroupUrl}>Join the Google Group</a>}
        {d.showDonate && <a class="btn btn-primary" href="/bts">Give to the Back-to-School campaign</a>}
      </div>
    )}
  </article>
</BaseLayout>
<style>
  /* No divider: the buttons belong to the page's closing section, so they sit right
     under its prose (the paragraph's own 1em bottom margin provides the gap). */
  .program-actions { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
</style>
